# TrustRAG Environment Configuration
# Copy this file to .env and adjust variables as needed.

# ==========================================
# 1. LOCAL OLLAMA (Default, No API Key Required)
# ==========================================
TRUSTRAG_LLM=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
TRUSTRAG_LLM_TIMEOUT=120

# ==========================================
# 2. RETRIEVAL & EMBEDDINGS (Local Only)
# ==========================================
TRUSTRAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
TRUSTRAG_CHUNK_CHARS=800
TRUSTRAG_CHUNK_OVERLAP=100
TRUSTRAG_TOP_K=4
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ==========================================
# 3. VERIFICATION CLASSIFIER
# ==========================================
TRUSTRAG_HALLU_THRESHOLD=0.5

# ==========================================
# 4. SERVER-MANAGED MULTI-PROVIDER CREDENTIALS (Optional)
# Users can also supply their own ephemeral keys in the UI
# (User keys are NEVER logged or saved to disk/SQLite).
# ==========================================
# OpenAI
# OPENAI_API_KEY=sk-proj-...

# Groq Cloud (Ultra-fast Llama-3.3-70b)
# GROQ_API_KEY=gsk_...

# Google Gemini (Gemini 2.0 Flash)
# GEMINI_API_KEY=AIzaSy...

# Anthropic Claude (Claude 3.5 Sonnet / Haiku)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter
# OPENROUTER_API_KEY=sk-or-v1-...

# Custom OpenAI-Compatible Server (vLLM, LMStudio, Ollama OpenAI port)
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_BASE_URL=http://localhost:8000/v1
